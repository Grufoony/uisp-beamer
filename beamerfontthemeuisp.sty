\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerfontthemeuisp}[2026/09/08 UISP font theme]
\mode<presentation>

\RequirePackage[sfdefault,scaled=.92,lining]{FiraSans}
\RequirePackage[scaled=.92,lining]{FiraMono}

\setbeamerfont{title}{size=\fontsize{25pt}{29pt},series=\bfseries}
\setbeamerfont{subtitle}{size=\fontsize{12pt}{15pt},series=\mdseries}
\setbeamerfont{author}{size=\fontsize{10.5pt}{13pt},series=\bfseries}
\setbeamerfont{institute}{size=\fontsize{9pt}{11pt}}
\setbeamerfont{date}{size=\fontsize{9pt}{11pt}}
\setbeamerfont{frametitle}{size=\fontsize{18pt}{20pt},series=\bfseries}
\setbeamerfont{framesubtitle}{size=\fontsize{9pt}{11pt}}
\setbeamerfont{section title}{size=\fontsize{10pt}{12pt},series=\bfseries}
\setbeamerfont{section page title}{size=\fontsize{31pt}{35pt},series=\bfseries}
\setbeamerfont{footline}{size=\fontsize{6.5pt}{8pt}}
\setbeamerfont{block title}{size=\footnotesize,series=\bfseries}
\setbeamerfont{block body}{size=\footnotesize}

\mode<all>
